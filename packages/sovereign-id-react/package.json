  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "test": "node --test tests/index.test.js",
    "prepublishOnly": "node --test tests/index.test.js"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mata",
    "matanetwork",
    "sovereign-id",
    "mid",
    "react",
    "react-hook",
    "sso",
    "identity",
    "did",
    "did-mata",
    "permissionless-auth",
    "self-sovereign"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/Remade-With-Rust/sovereign-id/tree/main/packages/sovereign-id-react#readme",
  "bugs": {
    "url": "https://github.com/Remade-With-Rust/sovereign-id/issues"
  },
  "repository": {
    "type": "git",
